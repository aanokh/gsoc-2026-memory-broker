+    public long getOperatorRequiredMemoryPerPartition(ILogicalOperator operator) {
+        if (operator.getOperatorTag() == LogicalOperatorTag.EXCHANGE) {
+            PhysicalOperatorTag exchangeTag = ((ExchangeOperator) operator).getPhysicalOperator().getOperatorTag();
+            if (exchangeTag == PhysicalOperatorTag.ONE_TO_ONE_EXCHANGE
+                    || exchangeTag == PhysicalOperatorTag.SORT_MERGE_EXCHANGE) {
+                return frameSize;
+            }
+            return 2L * MAX_BUFFER_PER_CONNECTION * numComputationPartitions * frameSize;
+        }
+        IPhysicalOperator physOp = ((AbstractLogicalOperator) operator).getPhysicalOperator();
+        return physOp.getLocalMemoryRequirements().getMemoryBudgetInBytes(frameSize)
+                + getOperatorExpressionsRequiredMemory(operator);
+    }
