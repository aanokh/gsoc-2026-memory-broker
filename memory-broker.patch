+    public static Map<String, Long> getRequiredNodeMemory(ILogicalPlan plan,
+            AlgebricksAbsolutePartitionConstraint computationLocations,
+            PhysicalOptimizationConfig physicalOptimizationConfig, CompilerProperties compilerProperties)
+            throws AlgebricksException {
+        String[] partitionNodes = computationLocations.getLocations();
+        OperatorResourcesComputer computer = new OperatorResourcesComputer(partitionNodes.length,
+                physicalOptimizationConfig.getFrameSize(), compilerProperties);
+        long partitionMemory =
+                getStages(plan).stream().mapToLong(stage -> stage.getRequiredMemoryPerPartition(computer)).max()
+                        .orElseThrow(IllegalStateException::new);
+        partitionMemory += partitionMemory * compilerProperties.getRuntimeMemoryOverheadPercentage() / 100;
+        Map<String, Long> nodeMemory = new HashMap<>();
+        for (String node : partitionNodes) {
+            nodeMemory.merge(node, partitionMemory, Long::sum);
+        }
+        return nodeMemory;
+    }
+
